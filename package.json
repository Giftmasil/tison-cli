{
  "name": "tison-cli",
  "version": "0.1.0",
  "description": "Scaffold curated AI-context files (CLAUDE.md, AGENTS.md, specs) into a project from hand-crafted templates.",
  "type": "module",
  "bin": {
    "tison": "./dist/cli.js"
  },
  "exports": "./dist/index.js",
  "files": [
    "dist/",
    "templates/"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli.js"
  },
  "keywords": [
    "cli",
    "claude",
    "agents.md",
    "scaffold",
    "ai",
    "templates"
  ],
  "license": "MIT",
  "dependencies": {
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/node": "^22.10.0"
  },
  "author": "Gift Muuo Masila",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YOUR_GITHUB_USERNAME/tison-cli.git"
  },
  "bugs": {
    "url": "https://github.com/YOUR_GITHUB_USERNAME/tison-cli/issues"
  },
  "homepage": "https://github.com/YOUR_GITHUB_USERNAME/tison-cli#readme",
  "publishConfig": {
    "access": "public"
  }
}
