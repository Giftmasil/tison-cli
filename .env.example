# Copy this file to `.env` and fill it in. `.env` is gitignored; this file is not.
#
# Required for `tison doctor`, `tison fill`, and `tison draft`. Nothing else in
# tison needs it — scaffolding, listing, and validating work with no key and no
# network.

# Get one at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=sk-or-v1-replace-me

# Optional. Defaults to deepseek/deepseek-v4-flash.
# Must be a slug that supports strict json_schema output:
# https://openrouter.ai/models?supported_parameters=structured_outputs
# TISON_MODEL=deepseek/deepseek-v4-flash

# Optional. Only change this to point at an OpenAI-compatible proxy.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional. App attribution — shows tison on OpenRouter's public leaderboards.
# TISON_HTTP_REFERER=https://github.com/Giftmasil/tison-cli
# TISON_APP_TITLE=tison-cli
